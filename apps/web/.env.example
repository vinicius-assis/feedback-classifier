# Optional. The app defaults to the same-origin path `/api`, which the Vite dev
# server proxies to the Nest API — no CORS setup needed for local development.
#
# Set this only when the API is served from a different origin. It must include
# the API's global prefix `/api`.
# VITE_API_BASE_URL=https://api.example.com/api

# Optional. Overrides the proxy target used by `vite dev` (default below).
# VITE_DEV_API_TARGET=http://localhost:3000
