{
  "name": "feedback-classifier",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.21.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @feedback-classifier/shared build && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @feedback-classifier/shared build && pnpm -r run test"
  }
}
